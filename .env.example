# 复制本文件为 .env 并填入真实配置（.env 已被 gitignore，不会提交）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codemax_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# LLM（S2-01-2 自然语言转 Mermaid）：OpenAI 兼容接口
# 通义千问兼容模式 https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
# DeepSeek https://api.deepseek.com/v1 + deepseek-chat ；本地 Ollama http://localhost:11434/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# 向量模型（S4-02-5 的语义 FAQ 检索用）。**必须单独指定**：
# 上面那个对话模型不能打 /embeddings，拿它去请求会得到 400 model_not_supported。
# 本地 Ollama 换成 nomic-embed-text 之类，与 LLM_MODEL 互不影响。
# 留空 LLM_API_KEY 时语义检索自动关闭，客服退回词袋检索，功能不受影响。
LLM_EMBED_MODEL=text-embedding-3-small

# 语义检索判定阈值：余弦相似度达到这个值才认作「命中 FAQ」，否则继续级联到 LLM 分类。
# 调高 = 更保守（宁可多花钱问 LLM 也不乱答）；调低 = 更容易直接作答但可能答错。
# ⚠ 改了 LLM_EMBED_MODEL 就必须重新标定这个值 —— 不同模型的余弦分布不一样。
# 0.55 是按 text-embedding-3-small 的经验值，尚未实测标定（TD-206）。
LLM_SEMANTIC_THRESHOLD=0.55

# 站点对外地址（S2-02-1）：sitemap.xml / robots.txt / canonical 用，必须绝对 URL
SITE_BASE_URL=https://codemax.top

# 微信支付 APIv3（S3-01）：六项缺一不可，没配齐 POST /shop/orders 返回 503
WX_APPID=
WX_MCHID=
WX_SERIAL_NO=
# 商户 API 私钥 apiclient_key.pem 的内容：整段用双引号包起来，换行写成 \n
WX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APIv3 密钥（32 字节），回调报文 AES-GCM 解密用
WX_API_V3_KEY=
# 支付结果回调地址，必须是公网可达的 https
WX_NOTIFY_URL=https://codemax.top/shop/pay/notify
# 微信支付平台证书（老商户）或微信支付公钥（新商户），PEM 文本；回调验签用。
# 证书会轮换，轮换后要换成新的，否则回调一律验签失败（TD-114）
WX_PLATFORM_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# 商品：阶段三只有一个 SKU，金额单位是分（19900 = ¥199）
SHOP_PRODUCT_NAME=毕设服务
SHOP_PRODUCT_AMOUNT=19900

# 支付通道（三选一）：
#   wechat = 微信支付，生产必须用这个（需商户号，TD-113）
#   mock   = 模拟收银台，登录用户自己点「确认支付」
#            ⚠️ 开着就等于免费发货，上线前必须改掉（TD-124）
#   manual = 展示静态收款码 + 管理员人工确认收款（无需商户号，S5-04 / TD-205）
SHOP_PAY_MODE=wechat

# manual 模式展示的收款码图片路径。换成你自己的收款码图片即可，代码不用动。
# 默认 pay_qr.png 是项目配置的收款码；部署前核实收款人，勿误用他人收款码。
# 演示占位图可显式设为 /static/pay_qr.svg；到账仍须管理员核验并人工确认。
SHOP_MANUAL_QR=/static/pay_qr.png

# 云存储（S3-02）：local = 本地目录（开发/演示）；oss / cos 需密钥，尚未实现（TD-128）
# 写成 oss/cos 会直接 503 报错，不会静默退回本地（TD-131）
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage
STORAGE_PRODUCT_KEY=product/codemax_package.zip
# 预签名下载链接的有效期（秒）
DOWNLOAD_URL_TTL=300

# 限流（TD-15）：/tools/* 刻意不设鉴权，任何人都能无限调用，所以必须限
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_TOOLS=30
# LLM 端点更严：每次调用都花钱
RATE_LIMIT_LLM=10
# 注册 / 登录：防在线爆破
RATE_LIMIT_AUTH=10
# ⚠️ 只有部署在**可信**反向代理之后才设 true；XFF 是客户端可伪造的头（TD-142）
TRUST_PROXY_HEADERS=false

# ─────────────────────────── 安全相关（上线前必看）───────────────────────────
# ⚠️⚠️ JWT 签名密钥。**默认值是 dev-secret-change-me，任何人都能拿它伪造登录态**。
# 生产环境必须改成随机长串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENV=production 时启动自检会拒绝用默认值启动（见 app/startup_checks.py）；
# 但 ENV 默认是 development，**自检根本不会跑** —— 所以下面这项也必须一起改。
SECRET_KEY=dev-secret-change-me
# 运行环境：development / production。只有 production 才会强制跑生产配置自检
# （SECRET_KEY、模拟支付开关、Secure cookie 等），见 TD-124。
ENV=development

# ─────────────────────────── 其余可调项（都有默认值）───────────────────────────
# 可选：直接给 SQLAlchemy URL，给了就**优先于**上面的 DB_HOST/DB_PORT/... （测试常用）
# 例如 postgresql+asyncpg://user:pwd@host:5432/dbname
DATABASE_URL=
# JWT 签名算法与登录态有效期（分钟）
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 订单超时关单（分钟）：二维码过期后自动关单，见 TD-100/109
ORDER_EXPIRE_MINUTES=30
# 每个用户最多存活的流程图数量（软删除的不占），见 TD-64
DIAGRAM_QUOTA=50
# 日志级别
LOG_LEVEL=INFO
# HSTS 的 max-age（秒），仅生产环境下发；31536000 = 1 年
HSTS_MAX_AGE=31536000
