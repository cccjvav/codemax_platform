# 复制本文件为 .env 并填入真实配置（.env 已被 gitignore，不会提交）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codemax_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# LLM：默认 Agnes 2.5 Flash（OpenAI Chat Completions 兼容协议）
# https://wiki.agnes-ai.com/en/docs/agnes-25-flash
# 只在私有 .env 填入你现有的 key；基址不要追加 /chat/completions。
LLM_API_KEY=
LLM_BASE_URL=https://apihub.agnes-ai.com/v1
LLM_MODEL=agnes-2.5-flash
# Agnes 公开文档未确认 embedding；默认关闭，聊天 key 不会触发向量预热。
# 只有确认同一提供方/账号支持 /embeddings 和具体模型后才启用；不猜模型名。
LLM_EMBED_ENABLED=false
LLM_EMBED_MODEL=
# 默认关闭时不使用此阈值；将来启用向量增强必须先运行真实模型标定。
LLM_SEMANTIC_THRESHOLD=0.55

# 站点对外地址（S2-02-1）：sitemap.xml / robots.txt / canonical 用，必须绝对 URL
SITE_BASE_URL=https://codemax.top

# 微信支付 APIv3（S3-01）：六项缺一不可，没配齐 POST /shop/orders 返回 503
WX_APPID=
WX_MCHID=
WX_SERIAL_NO=
# 商户 API 私钥 apiclient_key.pem 的内容：整段用双引号包起来，换行写成 \n
WX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APIv3 密钥（32 字节），回调报文 AES-GCM 解密用
WX_API_V3_KEY=
# 支付结果回调地址，必须是公网可达的 https
WX_NOTIFY_URL=https://codemax.top/shop/pay/notify
# 微信支付平台证书（老商户）或微信支付公钥（新商户），PEM 文本；回调验签用。
# 证书会轮换，轮换后要换成新的，否则回调一律验签失败（TD-114）
# 公钥模式必须填对应PUB_KEY_ID；证书模式可空，由X509序列号校验。不是商户WX_SERIAL_NO。
WX_PLATFORM_KEY_ID=
WX_PLATFORM_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# 商品：阶段三只有一个 SKU，金额单位是分（19900 = ¥199）
SHOP_PRODUCT_NAME=毕设服务
SHOP_PRODUCT_AMOUNT=19900

# 支付通道（三选一）：
#   wechat = 微信支付（需商户号）；生产也可用 manual 人工核账，不能用 mock
#   mock   = 模拟收银台，登录用户自己点「确认支付」
#            ⚠️ 开着就等于免费发货，上线前必须改掉（TD-124）
#   manual = 展示静态收款码 + 管理员人工确认收款（无需商户号，S5-04 / TD-205）
SHOP_PAY_MODE=wechat

# manual 模式展示的收款码图片路径。换成你自己的收款码图片即可，代码不用动。
# 默认 pay_qr.png 是项目配置的收款码；部署前核实收款人，勿误用他人收款码。
# 演示占位图可显式设为 /static/pay_qr.svg；到账仍须管理员核验并人工确认。
SHOP_MANUAL_QR=/static/pay_qr.png

# 云存储（S3-02）：local = 本地目录（开发/演示）；oss / cos 需密钥，尚未实现（TD-128）
# 写成 oss/cos 会直接 503 报错，不会静默退回本地（TD-131）
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=storage
STORAGE_PRODUCT_KEY=product/codemax_package.zip
# 预签名下载链接的有效期（秒）
DOWNLOAD_URL_TTL=300

# 限流（TD-15）：/tools/* 刻意不设鉴权，任何人都能无限调用，所以必须限
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_TOOLS=30
# LLM 端点更严：每次调用都花钱
RATE_LIMIT_LLM=10
# 注册 / 登录：防在线爆破
RATE_LIMIT_AUTH=10
# 站内留言发送：每 IP / 窗口次数（默认单实例）
RATE_LIMIT_SUPPORT_MESSAGES=30
# ⚠️ 只有部署在**可信**反向代理之后才设 true；XFF 是客户端可伪造的头（TD-142）
# Only trust the actual reverse proxy peer (comma-separated CIDRs).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUST_PROXY_HEADERS=false

# ─────────────────────────── 安全相关（上线前必看）───────────────────────────
# ⚠️⚠️ JWT 签名密钥。**默认值是 dev-secret-change-me，任何人都能拿它伪造登录态**。
# 生产环境必须改成随机长串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ENV=production 时启动自检会拒绝用默认值启动（见 app/startup_checks.py）；
# 但 ENV 默认是 development，**自检根本不会跑** —— 所以下面这项也必须一起改。
SECRET_KEY=dev-secret-change-me
# 运行环境：development / production。只有 production 才会强制跑生产配置自检
# （SECRET_KEY、模拟支付开关、Secure cookie 等），见 TD-124。
ENV=development
# 生产只信任明确登记的自有站点；这些客户端拿到完整站点登录凭据，不是第三方最小权限授权。
OAUTH_TRUSTED_CLIENT_IDS=[]

# ─────────────────────────── 其余可调项（都有默认值）───────────────────────────
# 可选：直接给 SQLAlchemy URL，给了就**优先于**上面的 DB_HOST/DB_PORT/... （测试常用）
# 例如 postgresql+asyncpg://user:pwd@host:5432/dbname
DATABASE_URL=
# JWT 签名算法与登录态有效期（分钟）
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 订单超时（分钟）：再次下单时关闭过期 pending；轮询只返回过期标志，不是后台定时任务
ORDER_EXPIRE_MINUTES=30
# 每个用户最多存活的流程图数量（软删除的不占），见 TD-64
DIAGRAM_QUOTA=50
# Includes deleted diagrams; permanently purge trash to release space.
DIAGRAM_TOTAL_QUOTA=200
DIAGRAM_BYTE_QUOTA=20000000
# 日志级别
LOG_LEVEL=INFO
# HSTS 的 max-age（秒），仅生产环境下发；31536000 = 1 年
HSTS_MAX_AGE=31536000

# Compose host binding; keep loopback when the reverse proxy runs on the host.
APP_BIND_HOST=127.0.0.1
