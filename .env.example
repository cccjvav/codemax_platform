# 复制本文件为 .env 并填入真实配置（.env 已被 gitignore，不会提交）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=codemax_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# LLM（S2-01-2 自然语言转 Mermaid）：OpenAI 兼容接口
# 通义千问兼容模式 https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen-plus
# DeepSeek https://api.deepseek.com/v1 + deepseek-chat ；本地 Ollama http://localhost:11434/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 站点对外地址（S2-02-1）：sitemap.xml / robots.txt / canonical 用，必须绝对 URL
SITE_BASE_URL=https://codemax.top

# 微信支付 APIv3（S3-01）：六项缺一不可，没配齐 POST /shop/orders 返回 503
WX_APPID=
WX_MCHID=
WX_SERIAL_NO=
# 商户 API 私钥 apiclient_key.pem 的内容：整段用双引号包起来，换行写成 \n
WX_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# APIv3 密钥（32 字节），回调报文 AES-GCM 解密用
WX_API_V3_KEY=
# 支付结果回调地址，必须是公网可达的 https
WX_NOTIFY_URL=https://codemax.top/shop/pay/notify
# 微信支付平台证书（老商户）或微信支付公钥（新商户），PEM 文本；回调验签用。
# 证书会轮换，轮换后要换成新的，否则回调一律验签失败（TD-114）
WX_PLATFORM_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# 商品：阶段三只有一个 SKU，金额单位是分（19900 = ¥199）
SHOP_PRODUCT_NAME=毕设服务
SHOP_PRODUCT_AMOUNT=19900
